{
  "name": "canton-dev (DAML JetBrains)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      "DAML_SDK_VERSION": "3.4.11"
    }
  },
  "remoteUser": "daml",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "runArgs": ["--init"],
  "mounts": [
    "source=canton-dev-vscode-server-extensions,target=/home/daml/.vscode-server/extensions,type=volume"
  ],
  "containerEnv": {
    "IDEA_PROPERTIES": "/etc/idea/idea.properties"
  },
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/home/daml/.dpm/bin:/home/daml/.daml/bin"
  },
  "postCreateCommand": "bash .devcontainer/postcreate.sh",
  "customizations": {
    "jetbrains": {
      "backend": "IntelliJ",
      "plugins": ["com.redhat.devtools.lsp4ij"]
    },
    "vscode": {
      "extensions": [
        "DigitalAssetHoldingsLLC.daml",
        "ms-vscode-remote.remote-containers",
        "mkhl.direnv"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "terminal.integrated.defaultProfile.linux": "bash",
        "editor.codeLens": true,
        "daml-language-server.trace.server": "verbose"
      }
    }
  },
  "forwardPorts": [5011, 5012, 5021, 5022, 5018, 5019, 7500, 7575]
}
