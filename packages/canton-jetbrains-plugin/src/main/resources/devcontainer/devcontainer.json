{
  "name": "Canton DAML JetBrains",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "DAML_SDK_VERSION": "3.4.11"
    }
  },
  "remoteUser": "daml",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "containerEnv": {
    "DPM_HOME": "/home/daml/.dpm",
    "CANTON_JETBRAINS_DEVCONTAINER": "1"
  },
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/home/daml/.dpm/bin:/home/daml/.daml/bin"
  },
  "forwardPorts": [
    5011,
    5012,
    5021,
    5022,
    5018,
    5019,
    7500,
    7575
  ],
  "customizations": {
    "jetbrains": {
      "backend": "IntelliJ"
    }
  },
  "features": {}
}
