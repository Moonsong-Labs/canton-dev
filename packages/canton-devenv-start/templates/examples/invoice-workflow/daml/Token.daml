-- | MockUSDC: A fungible stablecoin token implementation
-- This demonstrates how to create application-level tokens in Daml
-- that can be used for payments, similar to USDC on Ethereum
module Token where

-- | Type alias for token contract IDs
type TokenId = ContractId MockUSDC

-- | MockUSDC represents a fungible stablecoin token
-- Each contract represents a specific amount owned by a party
template MockUSDC
  with
    issuer : Party    -- The party that issued the token (e.g., a bank)
    owner : Party     -- Current owner of this token amount
    amount : Decimal  -- Amount of USDC (e.g., 1000.00)
  where
    signatory issuer, owner

    ensure amount > 0.0

    -- | Transfer tokens to a new owner
    choice Transfer : TokenId
      with
        newOwner : Party
      controller owner
      do
        assertMsg "New owner must differ from current owner" (newOwner /= owner)
        -- The archive-and-create pattern: Consume the old contract, create a new one.
        archive self
        create this with owner = newOwner

    -- | Split a token into two smaller amounts
    choice Split : (TokenId, TokenId)
      with
        splitAmount : Decimal
      controller owner
      do
        assertMsg "Split amount must be positive" (splitAmount > 0.0)
        assertMsg "Split amount must be less than total" (splitAmount < amount)
        let remainingAmount = amount - splitAmount
        -- The archive-and-create pattern: Consume the original, create two new ones.
        archive self
        token1 <- create this with amount = splitAmount
        token2 <- create this with amount = remainingAmount
        return (token1, token2)

    -- | Merge with another token contract
    choice Merge : TokenId
      with
        otherTokenCid : TokenId
      controller owner
      do
        otherToken <- fetch otherTokenCid
        assertMsg "Can only merge tokens from same issuer" (otherToken.issuer == issuer)
        assertMsg "Can only merge your own tokens" (otherToken.owner == owner)
        let totalAmount = amount + otherToken.amount
        -- The archive-and-create pattern: Consume both, create one consolidated contract.
        archive self
        archive otherTokenCid
        create this with amount = totalAmount
