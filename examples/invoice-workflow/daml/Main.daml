module Main where

import Daml.Script
import DA.Date (toDateUTC, addDays)

type InvoiceId = ContractId Invoice

data InvoiceStatus = Pending | Paid | Cancelled
  deriving (Eq, Show)

template Invoice
  with
    seller : Party
    buyer : Party
    invoiceNumber : Text
    amount : Decimal
    description : Text
    issueDate : Date
    dueDate : Date
    status : InvoiceStatus
  where
    ensure amount > 0.0 && invoiceNumber /= "" && dueDate >= issueDate
    signatory seller
    observer buyer

    choice PayInvoice : InvoiceId
      controller buyer
      do
        assertMsg "Invoice already paid or cancelled" (status == Pending)
        create this with status = Paid

    choice CancelInvoice : InvoiceId
      controller seller
      do
        assertMsg "Cannot cancel paid invoice" (status /= Paid)
        create this with status = Cancelled

setup : Script ()
setup = script do
  seller <- allocatePartyWithHint "AcmeCorp" (PartyIdHint "AcmeCorp")
  buyer <- allocatePartyWithHint "BuyerInc" (PartyIdHint "BuyerInc")

  sellerId <- validateUserId "seller"
  buyerId <- validateUserId "buyer"
  createUser (User sellerId (Some seller)) [CanActAs seller]
  createUser (User buyerId (Some buyer)) [CanActAs buyer]

  now <- getTime
  let today = toDateUTC now
      due = addDays today 30

  inv1 <- submit seller do
    createCmd Invoice with
      seller
      buyer
      invoiceNumber = "INV-001"
      amount = 1000.0
      description = "Software development services"
      issueDate = today
      dueDate = due
      status = Pending

  submit buyer do
    exerciseCmd inv1 PayInvoice

  return ()
