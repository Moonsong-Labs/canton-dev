-- | Invoice Workflow with Token Payments
-- This demonstrates how to integrate mockUSDC tokens with invoices
-- Invoices can be paid using actual token transfers (not just status changes)
module InvoiceWithTokens where

import Daml.Script
import DA.Date (toDateUTC, addDays)
import Token

type InvoiceId = ContractId TokenInvoice

data InvoiceStatus = Pending | Paid | Cancelled
  deriving (Eq, Show)

-- | Invoice that can be paid with mockUSDC tokens
template TokenInvoice
  with
    seller : Party
    buyer : Party
    invoiceNumber : Text
    amount : Decimal
    description : Text
    issueDate : Date
    dueDate : Date
    status : InvoiceStatus
    tokenIssuer : Party  -- Which token issuer to accept (e.g., USDCBank)
  where
    signatory seller
    observer buyer

    ensure amount > 0.0 && invoiceNumber /= "" && dueDate >= issueDate

    -- | Pay invoice with a token of the exact amount.
    choice PayWithExactToken : (InvoiceId, TokenId)
      with
        paymentTokenCid : ContractId MockUSDC
      controller buyer
      do
        assertMsg "Invoice already paid or cancelled" (status == Pending)
        paymentToken <- fetch paymentTokenCid
        assertMsg "Token must be owned by buyer" (paymentToken.owner == buyer)
        assertMsg "Token must be from correct issuer" (paymentToken.issuer == tokenIssuer)
        assertMsg "Token amount must match invoice amount" (paymentToken.amount == amount)

        -- Atomically transfer the token to the seller and update the invoice
        paidTokenCid <- exercise paymentTokenCid Transfer with newOwner = seller
        paidInvoiceCid <- create this with status = Paid
        return (paidInvoiceCid, paidTokenCid)

    -- | Pay with a larger token, receiving change back.
    choice PayWithChange : (InvoiceId, TokenId, TokenId)
      with
        paymentTokenCid : ContractId MockUSDC
      controller buyer
      do
        assertMsg "Invoice already paid or cancelled" (status == Pending)
        paymentToken <- fetch paymentTokenCid
        assertMsg "Token must be owned by buyer" (paymentToken.owner == buyer)
        assertMsg "Token must be from correct issuer" (paymentToken.issuer == tokenIssuer)
        assertMsg "Token amount must be >= invoice amount" (paymentToken.amount >= amount)

        -- Atomically split the token, transfer payment, and update invoice
        (paymentCid, changeCid) <- exercise paymentTokenCid Split with splitAmount = amount
        paidTokenCid <- exercise paymentCid Transfer with newOwner = seller
        paidInvoiceCid <- create this with status = Paid
        return (paidInvoiceCid, paidTokenCid, changeCid)

    -- | Cancel invoice (seller only, before payment)
    choice CancelInvoice : InvoiceId
      controller seller
      do
        assertMsg "Cannot cancel paid invoice" (status /= Paid)
        create this with status = Cancelled

-- | Complete workflow demonstration
setupInvoiceWithTokens : Script ()
setupInvoiceWithTokens = script do
  -- Create parties
  bank <- allocatePartyWithHint "USDCBank" (PartyIdHint "USDCBank")
  seller <- allocatePartyWithHint "AcmeCorp" (PartyIdHint "AcmeCorp")
  buyer <- allocatePartyWithHint "BuyerInc" (PartyIdHint "BuyerInc")

  -- Step 1: Bank issues tokens to buyer. The ledger enforces that both signatories,
  -- the `issuer` (bank) and `owner` (buyer), authorize this creation.
  buyerTokens <- submit bank do
    createCmd MockUSDC with
      issuer = bank
      owner = buyer
      amount = 10000.0

  -- Step 2: Seller creates an invoice
  now <- getTime
  let today = toDateUTC now
  invoice <- submit seller do
    createCmd TokenInvoice with
      seller
      buyer
      invoiceNumber = "INV-TOKEN-001"
      amount = 1500.0
      description = "Software development services - paid in USDC"
      issueDate = today
      dueDate = addDays today 30
      status = Pending
      tokenIssuer = bank

  -- Step 3: Buyer pays with tokens and gets change
  (paidInvoice, sellerToken, buyerChange) <- submit buyer do
    exerciseCmd invoice PayWithChange with
      paymentTokenCid = buyerTokens

  -- Verification
  Some paidInv <- queryContractId @TokenInvoice seller paidInvoice
  assert (paidInv.status == Paid)

  debug "Invoice payment with token and change successful."

  return ()
